  "progressions": {
   "why": "80s arena rock (DadCraft, Oct 26), from our Rock Corpus counts (maestro/data/rock.json): I, IV and V carry most of the time; around the era (1975-1991) half the songs reach for bVII, a third for bVI. Four-bar loops a chord a bar: the anthem's I-V-vi-IV, the double plagal (bVII to IV to I), the I-IV vamp turned home by V, the fifties loop; in a minor key the climb home through bVI and bVII. Loops mostly come round as written; every phrase lands home, so the lead's last note sits on its own chord.",
   "families": {
    "anthem": {
     "chords": "I | V | vi | IV",
     "weight": 3,
     "why": "the big major loop: home, the fifth, the relative minor, the fourth"
    },
    "double plagal": {
     "chords": "I | bVII | IV | I",
     "weight": 3,
     "why": "the flat seventh to the fourth to home: rock's own way round, the era's most borrowed chord"
    },
    "rock vamp": {
     "chords": "I IV | I IV | I IV | I V",
     "weight": 2,
     "why": "the commonest vamp in the counts, home and the fourth, turned by the fifth"
    },
    "fifties": {
     "chords": "I | vi | IV | V",
     "weight": 1,
     "why": "the old loop the ballads keep"
    },
    "climb home": {
     "chords": "I | IV | bVI | bVII",
     "weight": 2,
     "why": "the arena lift: the flat sixth and seventh climbing back to home"
    },
    "aeolian climb": {
     "chords": "i | bVI | bVII | i",
     "weight": 3,
     "why": "for a minor key: home, then the two chords that climb back to it"
    },
    "minor rock": {
     "chords": "i | bVII | bVI | bVII",
     "weight": 2,
     "why": "for a minor key: rocking down the steps under home and back"
    },
    "dark vamp": {
     "chords": "i | i | bVI | bVII",
     "weight": 2,
     "why": "for a minor key: home held, then the climb"
    }
   },
