  "arrange": {
    "why": "Son into montuno (Wikipedia's \"Salsa music\" and \"Son montuno\", in our own words): the body of the song first, then the montuno, the coro answering the lead, and now and then a mambo, the horns' turn. The first section is the body; a section may close on a break.",
    "opens": "cuerpo",
    "parts": {
      "cuerpo": {
        "when": "low",
        "weight": 1,
        "lead": "phrase",
        "horns": "punches",
