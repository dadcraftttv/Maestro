      "why": "Vamps that loop under the montuno, and ii-V cadences; a section keeps its vamp a long time.",
      "families": {
        "montuno vamp": {
          "chords": "i iv | V7 iv",
          "weight": 4,
          "why": "the son montuno's two-bar vamp: home, its subdominant, the dominant, back through iv"
        },
        "minor ii-V": {
          "chords": "iiø7 V7 | i7",
          "weight": 3,
          "why": "the ii-V into home, salsa's cadence, over and over"
        },
        "andalusian": {
          "chords": "i | bVII | bVI | V7",
          "weight": 2,
          "why": "four steps down to the dominant"
        },
        "minor circle": {
          "chords": "i7 | iv7 | bVII7 | bIIImaj7 | bVImaj7 | iiø7 | V7 | i7",
          "weight": 2,
          "why": "down by fifths through the whole key: the long road home"
        },
        "major montuno": {
          "chords": "I IV | V7 IV",
          "weight": 4,
          "why": "the vamp in a major key"
        },
        "major ii-V": {
          "chords": "ii7 V7 | Imaj7",
          "weight": 3,
          "why": "the ii-V into a major home"
        },
        "major turnaround": {
          "chords": "I | vi7 | ii7 | V7",
          "weight": 2,
          "why": "home, then round the circle back to it"
        }
